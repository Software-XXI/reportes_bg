---
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>Reportes BG</title>
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          sans-serif;
        background: #0a0a0a;
        color: #f0f0f0;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
      }

      header {
        text-align: center;
        padding: 16px;
        font-size: 18px;
        font-weight: 600;
        letter-spacing: 0.5px;
        color: #ccc;
        flex-shrink: 0;
      }

      .preview-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        background: #111;
        min-height: 240px;
      }

      #video {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: none;
      }

      #capturedPreview {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: none;
      }

      .placeholder {
        color: #555;
        font-size: 15px;
        text-align: center;
        padding: 20px;
      }

      .spinner {
        width: 40px;
        height: 40px;
        border: 3px solid #222;
        border-top-color: #888;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        display: none;
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }

      .result-area {
        display: none;
        padding: 20px;
        max-height: 35vh;
        overflow-y: auto;
        background: #141414;
        border-top: 1px solid #222;
        flex-shrink: 0;
      }

      .result-area.show {
        display: block;
      }

      .result-area p {
        font-size: 15px;
        line-height: 1.6;
        color: #ddd;
        white-space: pre-wrap;
      }

      .error-text {
        color: #ff6b6b;
        font-size: 13px;
        text-align: center;
        padding: 10px 16px;
        display: none;
        flex-shrink: 0;
      }

      .error-text.show {
        display: block;
      }

      .result-footer {
        display: flex;
        justify-content: flex-end;
        margin-top: 12px;
      }

      .btn-copy {
        background: none;
        border: 1px solid #333;
        color: #888;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 13px;
        cursor: pointer;
        transition: 0.15s;
      }

      .btn-copy:active {
        background: #1a1a1a;
      }

      .btn-copy.copied {
        color: #8fdaaf;
        border-color: #2a6a4a;
      }

      .bottom-bar {
        padding: 16px 20px;
        padding-bottom: calc(16px + env(safe-area-inset-bottom));
        flex-shrink: 0;
        background: #0a0a0a;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .btn {
        width: 100%;
        padding: 18px;
        font-size: 17px;
        font-weight: 600;
        border: none;
        border-radius: 14px;
        cursor: pointer;
        transition: background 0.2s, transform 0.1s;
        touch-action: manipulation;
      }

      .btn:active {
        transform: scale(0.97);
      }

      .btn-primary {
        background: #3a6ea5;
        color: #fff;
      }

      .btn-primary:active {
        background: #2d5885;
      }

      .btn-primary.loading {
        background: #2a4a6a;
        pointer-events: none;
      }

      .btn-primary.done {
        background: #2a6a4a;
      }

      .btn-primary.done:active {
        background: #1f5238;
      }

      .btn-secondary {
        background: #2a2a2a;
        color: #f0f0f0;
        border: 1px solid #444;
      }

      .btn-secondary:active {
        background: #3a3a3a;
      }

      #fileInput {
        display: none;
      }

      .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 100;
        padding: 20px;
      }

      .modal-overlay.hidden {
        display: none;
      }

      .modal {
        width: 100%;
        max-width: 360px;
        background: #141414;
        border: 1px solid #333;
        border-radius: 14px;
        padding: 24px;
      }

      .modal h2 {
        font-size: 17px;
        font-weight: 600;
        margin-bottom: 6px;
        color: #f0f0f0;
      }

      .modal p {
        font-size: 13px;
        color: #888;
        margin-bottom: 16px;
      }

      .modal input {
        width: 100%;
        padding: 12px;
        font-size: 16px;
        background: #0a0a0a;
        color: #f0f0f0;
        border: 1px solid #444;
        border-radius: 10px;
        outline: none;
        margin-bottom: 16px;
      }

      .modal input:focus {
        border-color: #3a6ea5;
      }
    </style>
  </head>
  <body>
    <div class="modal-overlay hidden" id="operadorModal">
      <div class="modal">
        <h2>Datos del operador</h2>
        <p>Escribe tu nombre y celular para identificarte en los reportes.</p>
        <input
          type="text"
          id="operadorInput"
          placeholder="Tu nombre"
          autocomplete="name"
          maxlength="60"
        />
        <input
          type="tel"
          id="celInput"
          placeholder="Tu celular"
          autocomplete="tel"
          maxlength="20"
        />
        <button class="btn btn-primary" id="btnSaveOperador">Confirmar</button>
      </div>
    </div>

    <header>Reportes BG</header>

    <div class="preview-container">
      <video id="video" autoplay playsinline muted></video>
      <img id="capturedPreview" alt="Preview" />
      <div class="spinner" id="spinner"></div>
      <div class="placeholder" id="placeholder">
        Presiona "Abrir cámara" para empezar
      </div>
    </div>

    <div class="error-text" id="errorText"></div>

    <div class="result-area" id="resultArea">
      <p id="resultText"></p>
      <div class="result-footer">
        <button class="btn-copy" id="btnCopy">📋 Copiar</button>
      </div>
    </div>

    <div class="bottom-bar">
      <button class="btn btn-primary" id="btnMain">Abrir cámara</button>
      <button class="btn btn-secondary" id="btnUpload" style="display:none">
        Subir imagen
      </button>
      <input type="file" id="fileInput" accept="image/*" />
    </div>

    <script>
      (function () {
        if (location.protocol !== "https:" && location.hostname !== "localhost" && location.hostname !== "127.0.0.1") {
          document.getElementById("placeholder").textContent = "Esta app requiere HTTPS para usar la cámara en iOS.";
          document.getElementById("btnMain").style.display = "none";
          document.getElementById("btnUpload").style.display = "block";
          return;
        }

        const video = document.getElementById("video");
        const capturedPreview = document.getElementById("capturedPreview");
        const placeholder = document.getElementById("placeholder");
        const spinner = document.getElementById("spinner");
        const btnMain = document.getElementById("btnMain");
        const btnUpload = document.getElementById("btnUpload");
        const fileInput = document.getElementById("fileInput");
        const errorText = document.getElementById("errorText");
        const resultArea = document.getElementById("resultArea");
        const resultText = document.getElementById("resultText");
        const btnCopy = document.getElementById("btnCopy");
        const operadorModal = document.getElementById("operadorModal");
        const operadorInput = document.getElementById("operadorInput");
        const celInput = document.getElementById("celInput");
        const btnSaveOperador = document.getElementById("btnSaveOperador");

        const OPERADOR_KEY = "bg_operador";
        const CEL_KEY = "bg_cel";

        function getOperador() {
          return localStorage.getItem(OPERADOR_KEY) || "";
        }

        function getCel() {
          return localStorage.getItem(CEL_KEY) || "";
        }

        function showOperadorModal() {
          operadorInput.value = getOperador();
          celInput.value = getCel();
          operadorModal.classList.remove("hidden");
          operadorInput.focus();
        }

        if (!getOperador() || !getCel()) {
          showOperadorModal();
        }

        btnSaveOperador.addEventListener("click", function () {
          const nombre = operadorInput.value.trim();
          const cel = celInput.value.trim();
          if (!nombre || !cel) {
            (nombre ? celInput : operadorInput).focus();
            return;
          }
          localStorage.setItem(OPERADOR_KEY, nombre);
          localStorage.setItem(CEL_KEY, cel);
          operadorModal.classList.add("hidden");
        });

        operadorInput.addEventListener("keydown", function (e) {
          if (e.key === "Enter") btnSaveOperador.click();
        });

        let stream = null;
        let cameraReady = false;

        function hideAll() {
          video.style.display = "none";
          capturedPreview.style.display = "none";
          spinner.style.display = "none";
          placeholder.style.display = "none";
          errorText.classList.remove("show");
          resultArea.classList.remove("show");
        }

        function showPlaceholder(msg) {
          hideAll();
          placeholder.textContent = msg;
          placeholder.style.display = "block";
        }

        function setBtnPrimary(text, className) {
          btnMain.textContent = text;
          btnMain.className = "btn btn-primary";
          if (className) btnMain.classList.add(className);
          btnMain.style.display = "block";
          btnUpload.style.display = "none";
        }

        async function startCamera() {
          try {
            stream = await navigator.mediaDevices.getUserMedia({
              video: { facingMode: "environment", width: { ideal: 1920 } },
              audio: false,
            });
            video.srcObject = stream;
            hideAll();
            video.style.display = "block";
            cameraReady = true;
            setBtnPrimary("Capturar foto");
          } catch (err) {
            try {
              stream = await navigator.mediaDevices.getUserMedia({
                video: { width: { ideal: 1920 } },
                audio: false,
              });
              video.srcObject = stream;
              hideAll();
              video.style.display = "block";
              cameraReady = true;
              setBtnPrimary("Capturar foto");
            } catch (err2) {
              console.error(err, err2);
              showPlaceholder(
                'No se pudo acceder a la cámara. Usa "Subir imagen".'
              );
              btnMain.style.display = "none";
              btnUpload.style.display = "block";
              cameraReady = false;
            }
          }
        }

        function stopCamera() {
          if (stream) {
            stream.getTracks().forEach((t) => t.stop());
            stream = null;
          }
          video.srcObject = null;
          cameraReady = false;
        }

        function captureFrame() {
          const MAX = 1280;
          let w = video.videoWidth;
          let h = video.videoHeight;
          if (w > MAX || h > MAX) {
            const ratio = Math.min(MAX / w, MAX / h);
            w = Math.round(w * ratio);
            h = Math.round(h * ratio);
          }
          const canvas = document.createElement("canvas");
          canvas.width = w;
          canvas.height = h;
          const ctx = canvas.getContext("2d");
          ctx.drawImage(video, 0, 0, w, h);
          return canvas.toDataURL("image/jpeg", 0.8).split(",")[1];
        }

        async function analyzeImage(imageBase64) {
          setBtnPrimary("Analizando...", "loading");
          spinner.style.display = "block";
          errorText.classList.remove("show");

          try {
            const res = await fetch("/api/gemini", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                image: imageBase64,
                operador: getOperador(),
                cel: getCel(),
              }),
            });

            let data;
            try {
              data = await res.json();
            } catch {
              throw new Error("Error de conexión con el servidor.");
            }

            if (!res.ok) throw new Error(data.error || "Error del servidor.");

            const operador = getOperador();
            const cel = getCel();
            let response = data.response;
            if (operador) {
              response = response.replace(
                /^👨🏻‍🚒\s*OPERADOR:.*$/m,
                `👨🏻‍🚒 OPERADOR: ${operador}`
              );
            }
            if (cel) {
              response = response.replace(
                /^📲\s*CEL:.*$/m,
                `📲 CEL: ${cel}`
              );
            }
            video.style.display = "none";
            capturedPreview.style.display = "block";
            resultText.textContent = response;
            resultArea.classList.add("show");
            setBtnPrimary("Nueva foto", "done");
            spinner.style.display = "none";
          } catch (err) {
            errorText.textContent = err.message;
            errorText.classList.add("show");
            setBtnPrimary("Reintentar", "");
            spinner.style.display = "none";
          }
        }

        function processFile(file) {
          const reader = new FileReader();
          reader.onload = function (e) {
            const img = new Image();
            img.onload = function () {
              const MAX = 1280;
              let w = img.naturalWidth;
              let h = img.naturalHeight;
              if (w > MAX || h > MAX) {
                const ratio = Math.min(MAX / w, MAX / h);
                w = Math.round(w * ratio);
                h = Math.round(h * ratio);
              }
              const canvas = document.createElement("canvas");
              canvas.width = w;
              canvas.height = h;
              const ctx = canvas.getContext("2d");
              ctx.drawImage(img, 0, 0, w, h);
              const base64 = canvas.toDataURL("image/jpeg", 0.8).split(",")[1];
              capturedPreview.src = canvas.toDataURL("image/jpeg", 0.8);
              hideAll();
              capturedPreview.style.display = "block";
              analyzeImage(base64);
            };
            img.src = e.target.result;
          };
          reader.readAsDataURL(file);
        }

        // --- Eventos ---

        btnMain.addEventListener("click", function () {
          const text = btnMain.textContent;

          if (text === "Abrir cámara") {
            showPlaceholder("Solicitando cámara...");
            setBtnPrimary("Abrir cámara", "loading");
            startCamera();
            return;
          }

          if (text === "Capturar foto") {
            const imageBase64 = captureFrame();
            capturedPreview.src = `data:image/jpeg;base64,${imageBase64}`;
            hideAll();
            capturedPreview.style.display = "block";
            stopCamera();
            analyzeImage(imageBase64);
            return;
          }

          if (text === "Nueva foto") {
            stopCamera();
            capturedPreview.style.display = "none";
            resultArea.classList.remove("show");
            errorText.classList.remove("show");
            showPlaceholder('Presiona "Abrir cámara" para empezar');
            setBtnPrimary("Abrir cámara");
            return;
          }

          if (text === "Reintentar") {
            errorText.classList.remove("show");
            capturedPreview.style.display = "none";
            showPlaceholder("Solicitando cámara...");
            setBtnPrimary("Abrir cámara", "loading");
            startCamera();
            return;
          }
        });

        btnUpload.addEventListener("click", function () {
          fileInput.click();
        });

        fileInput.addEventListener("change", function () {
          if (this.files && this.files[0]) {
            processFile(this.files[0]);
          }
        });

        function showCopied() {
          btnCopy.textContent = "✓ Copiado";
          btnCopy.classList.add("copied");
          setTimeout(() => {
            btnCopy.textContent = "📋 Copiar";
            btnCopy.classList.remove("copied");
          }, 2000);
        }

        btnCopy.addEventListener("click", async function () {
          const text = resultText.textContent;
          try {
            await navigator.clipboard.writeText(text);
            showCopied();
          } catch {
            const ta = document.createElement("textarea");
            ta.value = text;
            ta.style.position = "fixed";
            ta.style.opacity = "0";
            document.body.appendChild(ta);
            ta.select();
            try {
              document.execCommand("copy");
              showCopied();
            } catch {
              errorText.textContent = "No se pudo copiar al portapapeles";
              errorText.classList.add("show");
            }
            document.body.removeChild(ta);
          }
        });

        // Fallback: si el usuario carga imagen desde galería
        // cuando la cámara ya está activa
        btnMain.addEventListener("contextmenu", function (e) {
          e.preventDefault();
          fileInput.click();
        });
      })();
    </script>
  </body>
</html>
